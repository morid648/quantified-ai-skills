{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinanceDocumentSchemaSpecification",
  "description": "Validation schema specifications across all 5 financial document categories in the 50-doc benchmark.",
  "categories": {
    "invoice": {
      "type": "object",
      "required": ["vendor_name", "invoice_number", "invoice_date", "subtotal", "tax_amount", "total_amount", "line_items"],
      "properties": {
        "vendor_name": { "type": "string" },
        "invoice_number": { "type": "string" },
        "invoice_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "due_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "subtotal": { "type": "number", "minimum": 0 },
        "tax_amount": { "type": "number", "minimum": 0 },
        "total_amount": { "type": "number", "minimum": 0 },
        "line_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["description", "quantity", "unit_price", "amount"],
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number", "minimum": 0 },
              "unit_price": { "type": "number", "minimum": 0 },
              "amount": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "bank_statement": {
      "type": "object",
      "required": ["bank_name", "account_number", "statement_period_start", "statement_period_end", "opening_balance", "closing_balance", "transactions"],
      "properties": {
        "bank_name": { "type": "string" },
        "account_number": { "type": "string" },
        "statement_period_start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "statement_period_end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "opening_balance": { "type": "number" },
        "closing_balance": { "type": "number" },
        "transactions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["date", "description", "amount", "balance"],
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "description": { "type": "string" },
              "amount": { "type": "number" },
              "balance": { "type": "number" }
            }
          }
        }
      }
    },
    "income_statement": {
      "type": "object",
      "required": ["company_name", "fiscal_period", "total_revenue", "cost_of_goods_sold", "gross_profit", "operating_expenses", "operating_income", "net_income"],
      "properties": {
        "company_name": { "type": "string" },
        "fiscal_period": { "type": "string" },
        "total_revenue": { "type": "number" },
        "cost_of_goods_sold": { "type": "number" },
        "gross_profit": { "type": "number" },
        "operating_expenses": { "type": "number" },
        "operating_income": { "type": "number" },
        "net_income": { "type": "number" }
      }
    },
    "expense_report": {
      "type": "object",
      "required": ["employee_name", "report_id", "submission_date", "total_amount", "approval_status", "expense_items"],
      "properties": {
        "employee_name": { "type": "string" },
        "report_id": { "type": "string" },
        "submission_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "total_amount": { "type": "number", "minimum": 0 },
        "approval_status": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED"] },
        "expense_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["date", "category", "merchant", "amount"],
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "category": { "type": "string", "enum": ["MEALS", "TRAVEL", "LODGING", "SOFTWARE", "SUPPLIES"] },
              "merchant": { "type": "string" },
              "amount": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "loan_application": {
      "type": "object",
      "required": ["applicant_name", "id_type", "id_number", "annual_income", "requested_amount", "loan_purpose", "risk_flags"],
      "properties": {
        "applicant_name": { "type": "string" },
        "id_type": { "type": "string", "enum": ["SSN", "PASSPORT", "TAX_ID"] },
        "id_number": { "type": "string" },
        "annual_income": { "type": "number", "minimum": 0 },
        "requested_amount": { "type": "number", "minimum": 0 },
        "loan_purpose": { "type": "string" },
        "risk_flags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
